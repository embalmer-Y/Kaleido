	prompt "TTS provider"
	default KS_TTS_PROVIDER_MINIMAX
	config KS_TTS_PROVIDER_DASHSCOPE
		bool "DashScope cosyvoice (WS)"
	config KS_TTS_PROVIDER_MINIMAX
		bool "MiniMax t2a_v2 (HTTPS SSE)"
endchoice

