# voice-loop-p4 HIL：百炼全链延迟实测（osptek P4C5，D-8 平台切换版）
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# W-4：国内云 NLB 需 TLS1.3（M1 实证）
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# 本板实测（V-38 勘误口径）：Boya 16MB QIO@80MHz 通用驱动即稳；
# no-stub 走 ROM 模式（stub 起不来）；B-2 挂死真因为 XIP-from-PSRAM
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_ESPTOOLPY_NO_STUB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# --- WiFi over C5（esp_hosted 2.12.9，26 号 §2）---
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
# SDIO 引脚用 P4 无预设默认值，恰=核心板实测走线：
# CLK=18 CMD=19 D0=14 D1=15 D2=16 D3=17、复位=GPIO54（手册 p10 + esp_hosted 默认双验证）

# 网络调优回退：streaming 模式下大窗口引发 sdio_rx_get_buffer 对齐分配断言
#（sdio_drv.c:953，内部堆碎片化；MAX_SIZE 预分配模式在 2.12.9 启动即断言）。
# 回默认配置保稳定，提速改由 TTS 预热/连接复用承担，专项浸泡后再引入。
CONFIG_LWIP_TCP_SACK_OUT=y
# esp_hosted 缓冲池优先 PSRAM（需 64B 缓存行，见上）
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
