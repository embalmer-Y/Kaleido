# dsi-lvgl：osptek 10.1" JD9366 点屏 + LVGL（原厂例程移植，我们的板级基线）
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
# 显示性能基线（osptek 例程同款）；XIP 先关（B-2 挂死未结案，显示链不依赖）
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 本板烧写与 flash 基线：Boya 16MB QIO@80MHz、no-stub 直写。
# V-38 勘误：Boya 专用驱动曾是“安慰剂”（符号拼错从未生效），通用驱动
# + QIO@80MHz 30+ 次启动实测稳定；B-2 启动挂死真因是 XIP-from-PSRAM，
# 与 flash 驱动无关
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_ESPTOOLPY_NO_STUB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_FREERTOS_HZ=1000
# LVGL（osptek 例程口径 + demo 补齐）
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_DEMO_WIDGETS=y
# benchmark demo 弃用：本板渲染其汇总表会崩（V-35R），FPS 走自建
# REFR_READY 计数（main.c fps_test）
# LV_USE_OS 与 esp_lvgl_port 信号机制不匹配（tick 通知死等）：关掉，渲染单元降 1
CONFIG_LV_USE_PERF_MONITOR=y
# 跑分负载下渲染任务可能长占 CPU：放宽双看门狗（正式固件再议）
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_INT_WDT_TIMEOUT_MS=3000
