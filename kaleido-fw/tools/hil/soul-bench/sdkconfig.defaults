# soul-bench common config (variant "noXIP" = XIP off, the V-35 candidate)
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_BSS_EXTERNAL_MEMORY=y
# logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
# shutdown services we don't need for a bench
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_BT_ENABLED=n
CONFIG_ESP_NETIF_NONE=y
# App must link to ota_0 @0x20000 to match the on-board Korvo-1 partition table
# (we ONLY flash the app partition, never bootloader/table/NVS).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# V-35 variant note: this file = XIP OFF (SPIRAM_XIP_FROM_PSRAM default n)
# V2 修订（首轮真机：cJSON 节点打穿内部堆至 12B + CPU1 WDT 恐慌）
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y
# V3 fix: ThorVG thread build asserts pthread_self in raw FreeRTOS task (see v34_xip_on_v2 log); use synchronous rendering only
