# p4-bringup：osptek P4C5 底板冒烟基线
# 烧写走 ROM 模式：本板 stub 起不来（921600/460800/230400 均无响应），实测 --no-stub@230400 稳定
CONFIG_ESPTOOLPY_NO_STUB=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_FLASH_CHIP=y
# 控制台走 UART0（板载 CH343P 调试口），不用 USB-Serial-JTAG
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# 32MB 片内叠封 HEX PSRAM@200MHz（默认模式/速度即正确值）
CONFIG_SPIRAM=y
# 沿用出厂分区布局（factory 8MB @0x20000 + storage 7MB），换板后可无缝恢复出厂
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
