# convo-stage：V-45 舞台×语音联动（voice-loop-p4 ∪ dsi-lvgl 配置并集）
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# 8192：64B 行吃掉大量内部 tag RAM，合并应用需回收预留池空间
#（hosted 池在 PSRAM、I2S DMA 先于一切分配，32K 预留职责已被替代）
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=8192
# 显示性能基线（osptek 例程同款）
CONFIG_CACHE_L2_CACHE_256KB=y
# 64B：esp_hosted PSRAM mempool 与 128B 行组合使 TX 缓冲半数非法
#（esp-hosted-mcu #219 确认修，实测 64B 下合并应用可完整启动）
CONFIG_CACHE_L2_CACHE_LINE_64B=y
# 本板烧写与 flash 基线（V-38 勘误口径：通用驱动+QIO 即稳）
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_ESPTOOLPY_NO_STUB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# W-4：国内云 NLB 需 TLS1.3；WDT 口径同两侧 HIL
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_INT_WDT_TIMEOUT_MS=3000
# --- WiFi over C5（esp_hosted 2.12.9）---
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
# --- WakeNet ---
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
# --- LVGL（dsi-lvgl 口径）---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# LV_USE_OS 与 esp_lvgl_port 信号机制不匹配（tick 通知死等）：关掉
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# panic 处理器驻 IRAM：'W' 族硬锁死不吐转储的取证前提（V-45）
CONFIG_ESP_PANIC_HANDLER_IRAM=y
# 运行时统计（'u' 键 vTaskGetRunTimeStats）
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# V-45：大音频缓冲迁 PSRAM（EXT_RAM_BSS_ATTR），给 LVGL/I2S DMA/TLS 腾内部 RAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# V-45：舞台由单一 pthread 同步驱动（draw+sync 串行），关闭 thorvg 内部线程池（省 ~200KB 内部 RAM）

# ---- KF 崩溃取证包（V-45R）：panic/WDT 转储落 flash coredump 分区 ----
CONFIG_ESP_COREDUMP_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16
CONFIG_ESP_COREDUMP_STACK_SIZE=2048

CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y

# V-46c：mbedtls 缓冲迁 PSRAM（驻留 AFE 后内部水位线）
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
